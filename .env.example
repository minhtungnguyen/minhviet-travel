# Copy to .env.local and fill in real values before deploying.
# Without these set, lead/newsletter submissions are only logged
# server-side (see lib/actions/lead-action.ts, newsletter-action.ts) —
# the visitor still sees an honest success message, but no one on the
# CRM/marketing side receives the submission.

# CRM webhook that receives homepage lead-form submissions
# (corporate + individual inquiry, AI Advisor hand-off).
LEADS_WEBHOOK_URL=

# Webhook that receives footer newsletter subscriptions.
NEWSLETTER_WEBHOOK_URL=

# --- Supabase (mv-travel-os-dev, ap-southeast-1) ---
# Never point these at minhviet-erp, mivigo, or any other former project.
# Get values from the Supabase dashboard (Project Settings > API / Database),
# never from a terminal/chat log.

# Public API URL — safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon/publishable key — protected by RLS, safe to expose client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only direct Postgres connection string (for migration tooling).
SUPABASE_DATABASE_URL=

# Seed-provisioned defaults consumed by application code (see
# database/seeds/0002_organization.sql) — Minh Viet Travel org / brand / website.
DEFAULT_ORGANIZATION_ID=
DEFAULT_BRAND_ID=
DEFAULT_WEBSITE_ID=

APP_URL=
ADMIN_APP_URL=
LOG_LEVEL=
